        }
      },
      "reauth_confirm": {
        "title": "Garmin API key needs replacing",
        "description": "The Personal API key for {title} has expired or was revoked. Create a new one at [Garmin Connect → Settings → Personal API Key]({key_url}) and paste it here.",
