{
  "config": {
    "step": {
      "user": {
        "title": "Connect your Garmin account",
        "description": "Create a Personal API key at [Garmin Connect → Settings → Personal API Key]({key_url}) (pick the longest expiry you're comfortable with), then paste it here. The key is only shown once on Garmin's site.",
        "data": {
          "api_key": "Personal API key",
          "region": "Garmin Connect server"
        },
        "data_description": {
          "api_key": "Starts working immediately. Garmin emails you about a week before it expires.",
          "region": "Use China only if your account is on connect.garmin.cn."
        }
      },
      "reauth_confirm": {
        "title": "Garmin API key needs replacing",
        "description": "The Personal API key for {title} has expired or was revoked. Create a new one at [Garmin Connect → Settings → Personal API Key]({key_url}) and paste it here.",
        "data": {
          "api_key": "Personal API key"
        }
      }
    },
    "error": {
      "invalid_auth": "Garmin rejected that key. Check it was copied in full and hasn't expired or been deleted.",
      "cannot_connect": "Couldn't reach Garmin. Check Home Assistant's internet connection and try again.",
      "unknown": "Garmin sent an unexpected response. Check the Home Assistant logs."
    },
    "abort": {
      "already_configured": "This Garmin account is already set up.",
      "reauth_successful": "New key saved. Garmin data will resume shortly.",
      "wrong_account": "That key belongs to a different Garmin account."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Garmin polling",
        "data": {
          "scan_interval": "Update interval"
        },
        "data_description": {
          "scan_interval": "How often to fetch today's summary (steps, heart rate, Body Battery, stress). Sleep, HRV, weight and activities are fetched at most hourly."
        }
      }
    }
  },
  "selector": {
    "region": {
      "options": {
        "global": "Global (connect.garmin.com)",
        "china": "China (connect.garmin.cn)"
      }
    }
  },
  "issues": {
    "key_expiring": {
      "title": "Garmin API key expires soon",
      "description": "The Personal API key for {title} expires at {expires}. Create a new key in Garmin Connect now. When the old key stops working, Home Assistant will show a re-authentication prompt for this integration where you paste the new one."
    }
  },
