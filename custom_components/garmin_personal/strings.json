  "services": {
    "download_activity": {
      "name": "Download activity file",
      "description": "Saves an activity's original FIT file from Garmin into the garmin_activities folder in your Home Assistant config directory. Returns the saved file paths.",
      "fields": {
        "activity_id": {
          "name": "Activity ID",
          "description": "Which activity to download. Leave empty for the most recent one. The ID is on the Last activity sensor and in each calendar event."
        },
        "config_entry_id": {
          "name": "Garmin account",
          "description": "Only needed if you've added more than one Garmin account."
        }
      }
    }
